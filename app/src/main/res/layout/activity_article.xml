<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/C5"
    tools:context=".ArticleActivity">

    <ImageButton
        android:id="@+id/imageButton26"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#00FFFFFF"
        android:contentDescription="@string/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/back"
        tools:ignore="TouchTargetSizeCheck" />

    <TextView
        android:id="@+id/textView93"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:fontFamily="serif"
        android:text="Articles"
        android:textColor="@color/C4"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <SearchView
        android:id="@+id/searchView3"
        android:layout_width="368dp"
        android:layout_height="51dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/rounded_background"
        android:backgroundTint="#74FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.511"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView93" />

    <TextView
        android:id="@+id/textView94"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:text="Popular Articles"
        android:textColor="@color/C4"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchView3" />

    <Button
        android:id="@+id/button25"
        android:layout_width="113dp"
        android:layout_height="57dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/C3"
        android:text="Covid-19"
        android:textColor="@color/C2"
        app:layout_constraintEnd_toStartOf="@+id/button26"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView94" />

    <Button
        android:id="@+id/button26"
        android:layout_width="105dp"
        android:layout_height="57dp"
        android:backgroundTint="@color/C3"
        android:text="Diet"
        android:textColor="@color/C2"
        app:layout_constraintEnd_toStartOf="@+id/button27"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/button25"
        app:layout_constraintTop_toTopOf="@+id/button25" />

    <Button
        android:id="@+id/button27"
        android:layout_width="105dp"
        android:layout_height="57dp"
        android:backgroundTint="@color/C3"
        android:text="Fitness"
        android:textColor="@color/C2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/button26"
        app:layout_constraintTop_toTopOf="@+id/button25" />

    <TextView
        android:id="@+id/textView95"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="32dp"
        android:text="Treanding Articles"
        android:textColor="@color/C4"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button25" />

    <TextView
        android:id="@+id/textView97"
        android:layout_width="179dp"
        android:layout_height="225dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/rounded_background"
        android:backgroundTint="#74FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView95" />

    <TextView
        android:id="@+id/textView98"
        android:layout_width="179dp"
        android:layout_height="225dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/rounded_background"
        android:backgroundTint="#74FFFFFF"
        app:layout_constraintStart_toEndOf="@+id/textView97"
        app:layout_constraintTop_toTopOf="@+id/textView97" />

    <ImageView
        android:id="@+id/imageView31"
        android:layout_width="151dp"
        android:layout_height="109dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="11dp"
        app:layout_constraintStart_toStartOf="@+id/textView97"
        app:layout_constraintTop_toTopOf="@+id/textView97"
        app:srcCompat="@drawable/diabete" />

    <ImageView
        android:id="@+id/imageView35"
        android:layout_width="149dp"
        android:layout_height="109dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="11dp"
        app:layout_constraintStart_toStartOf="@+id/textView98"
        app:layout_constraintTop_toTopOf="@+id/textView98"
        app:srcCompat="@drawable/blood" />

    <TextView
        android:id="@+id/textView100"
        android:layout_width="131dp"
        android:layout_height="75dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="135dp"
        android:text="@string/ar2"
        android:textColor="@color/C3"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/textView98"
        app:layout_constraintTop_toTopOf="@+id/textView98" />

    <TextView
        android:id="@+id/textView99"
        android:layout_width="143dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="132dp"
        android:text="@string/ar1"
        android:textColor="@color/C3"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/textView97"
        app:layout_constraintTop_toTopOf="@+id/textView97" />

    <Button
        android:id="@+id/button28"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="96dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/C5"
        android:text="See all"
        android:textColor="@color/C1"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/textView95"
        app:layout_constraintTop_toBottomOf="@+id/button27" />

    <TextView
        android:id="@+id/textView101"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
